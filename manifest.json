{
  "manifest_version": 3,
  "name": "Ozon TMS — мониторинг рейсов",
  "version": "1.2.2",
  "description": "Периодически обновляет страницу tms.ozon.ru и уведомляет о новых рейсах по заданным критериям.",
  "permissions": [
    "storage",
    "notifications",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://tms.ozon.ru/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ozon TMS watcher"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tms.ozon.ru/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://tms.ozon.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "update.html",
  "web_accessible_resources": [
    {
      "resources": [
        "query.js"
      ],
      "matches": [
        "https://tms.ozon.ru/*"
      ]
    }
  ]
}